{
  "name": "stele-spec",
  "version": "0.1.0-rc.5",
  "packageManager": "npm@11.13.0",
  "type": "module",
  "bin": {
    "openspec": "node_modules/@fission-ai/openspec/bin/openspec.js",
    "stele": "dist/stele"
  },
  "description": "Maintain software from plain-English specifications with deterministic implementation evidence",
  "license": "MIT",
  "author": "Jens Van Steen <jensvansteen@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jensvansteen/stele.git"
  },
  "homepage": "https://jensvansteen.github.io/stele/",
  "bugs": "https://github.com/jensvansteen/stele/issues",
  "keywords": [
    "openspec",
    "specification",
    "verification",
    "traceability",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "files": [
    "dist/",
    "scripts/select-binary.mjs",
    "docs/.vitepress/",
    "docs/concepts/",
    "docs/guide/",
    "docs/intent/",
    "docs/public/",
    "docs/reference/",
    "docs/index.md",
    "docs/OPENSPEC_AND_STELE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-go.mts",
    "prepare": "git config --local core.hooksPath .githooks",
    "postinstall": "node scripts/select-binary.mjs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format:check": "go run ./tools/goquality format",
    "lint": "npm run lint:go && npm run lint:ts",
    "lint:fix": "npm run lint:go:fix && npm run lint:ts:fix",
    "lint:go": "golangci-lint run ./cmd/... ./internal/... ./tests/... ./tools/...",
    "lint:go:fix": "golangci-lint run --fix ./cmd/... ./internal/... ./tests/... ./tools/...",
    "lint:ts": "eslint --flag unstable_native_nodejs_ts_config \"**/*.{ts,mts}\"",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "typecheck": "npm run typecheck:go && npm run typecheck:ts",
    "typecheck:go": "go vet ./cmd/... ./internal/... ./tools/... && go vet -tags=integration ./tests",
    "typecheck:ts": "tsc --noEmit",
    "type-coverage": "type-coverage --at-least 100 --strict --detail --project tsconfig.json",
    "test:go": "go test -race ./cmd/... ./internal/... ./tools/...",
    "test:coverage": "go run ./tools/goquality coverage",
    "test:node": "node --test --test-concurrency=1 --test-reporter=spec tests/cli.test.mts",
    "test:package": "go test -race -tags=integration ./tests",
    "test": "npm run format:check && npm run typecheck && npm run type-coverage && npm run test:go && npm run test:coverage && npm run build && npm run test:node && npm run test:package",
    "prepack": "npm run build",
    "stele": "npm run build --silent && ./dist/stele",
    "verify": "npm run lint && npm test",
    "stele:published": "stele",
    "verify:self": "npm run build --silent && stele check --specs"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "stele-published": "npm:stele-spec@0.1.0-rc.4",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitepress": "^1.6.4"
  },
  "bundleDependencies": [
    "@fission-ai/openspec"
  ]
}
